# Copy this file to .env; never commit the filled-in .env
ADMIN_USERS=replace_with_existing_navidrome_username
NAVIDROME_URL=http://192.168.1.20:4533
DOWNLOADER_URL=http://192.168.1.20:8383
# false for LAN/Tailscale HTTP testing. Set true when serving Jobbi through
# a Cloudflare Tunnel HTTPS hostname. Secure cookies require HTTPS for sign-in.
# Cloudflare still forwards to http://NAS:3131 on the private LAN.
PUBLIC_HTTPS=false
# Optional direct slskd search; set key only in local .env, NEVER commit it
SLSKD_URL=http://192.168.1.20:5030
SLSKD_API_KEY=
# Keep OFF until live native API canary passes; admin accounts are still visible
ENABLE_ACCOUNT_MANAGEMENT=false

# Required for social features: generate a unique random password on the NAS.
# Example: openssl rand -hex 32 (do not commit or share it)
SOCIAL_DB_PASSWORD=


# Optional Invidious discovery fallback. Your own instance is attempted first.
INVIDIOUS_URL=https://yt.jobbisoft.com.mx
# Comma-separated HTTPS alternate instances; check their policies/availability.
INVIDIOUS_BACKUPS=
# Optional: audio import from videos that you have the rights to save.
# Enable only after creating /volume1/music/Jobbi Imports with write access
# for the configured worker UID and explicitly starting the invidious-import profile.
INVIDIOUS_WORKER_URL=
INVIDIOUS_WORKER_SECRET=
IMPORT_WORKER_UID=1000
IMPORT_WORKER_GID=100

# Optional admin-only reversible NAS audio removal.
# Disabled unless the separate quarantine profile has been explicitly enabled.
# Set MUSIC_QUARANTINE_URL=http://jobbi-quarantine:3137 after setup.
# Generate MUSIC_QUARANTINE_SECRET locally with openssl rand -hex 32.
# Keep a writable NAS music share permission for the dedicated worker UID.
MUSIC_QUARANTINE_URL=
MUSIC_QUARANTINE_SECRET=
QUARANTINE_UID=1000
QUARANTINE_GID=100
